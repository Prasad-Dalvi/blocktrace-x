# BlockTrace-X local development configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=blocktrace-x-dev-secret-key-change-in-production
JWT_SECRET_KEY=blocktrace-x-jwt-secret-key-change-in-production

# SQLite is used by default for local development.
DATABASE_URL=sqlite:///blocktrace_dev.db
# DATABASE_URL=postgresql://blocktrace:blocktrace_pass@db:5432/blocktrace_db

# Local Hardhat Ethereum node. This key is for the public Hardhat test account only.
HARDHAT_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545